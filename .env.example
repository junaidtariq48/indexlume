NODE_ENV=development

POSTGRES_DB=open_search_console
POSTGRES_USER=open_search_console
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://open_search_console:local-development-only@postgres:5432/open_search_console

REDIS_URL=redis://redis:6379

TYPESENSE_URL=http://typesense:8108
TYPESENSE_API_KEY=local-typesense-admin-key-change-me
APP_ENCRYPTION_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXk=
APP_ENCRYPTION_KEY_PREVIOUS=
# Keep these stable while rotating APP_ENCRYPTION_KEY. Use independent random
# 32-byte base64 values outside local development.
APP_HMAC_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXk=
SEARCH_KEY_PEPPER=bG9jYWwtZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXk=
SEARCH_KEY_PEPPER_PREVIOUS=
ALLOW_PRIVATE_TYPESENSE=false
ALLOW_INSECURE_TYPESENSE=false
ALLOW_PRIVATE_POSTGRES=false
ALLOW_INSECURE_POSTGRES=false
ENABLE_RELATIONAL_PROJECTIONS=true
TYPESENSE_REQUEST_TIMEOUT_MS=5000
UPLOAD_STAGING_DIR=/var/lib/osc/uploads
MAX_UPLOAD_BYTES=25000000
INGEST_BATCH_DOCUMENTS=500
INGEST_BATCH_BYTES=1000000
INGEST_WORKER_CONCURRENCY=2

SETUP_TOKEN=local-setup-token-change-me
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_SEARCH_RATE_LIMIT_MAX=120
PUBLIC_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

API_PORT=3001
HOST_API_PORT=3001
HOST_WEB_PORT=3000
INTERNAL_API_URL=http://api:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
